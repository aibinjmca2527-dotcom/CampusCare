# =============================================================================
# CampusCare – SMTP Email Configuration Template
# =============================================================================
# Instructions:
# 1. Copy this file to 'email.properties' in the same directory (web/WEB-INF/):
#    cp email.properties.example email.properties
# 2. Update the credentials below with your SMTP account details.
# 3. Rebuild and deploy the application.
# For full setup instructions, see EMAIL_SETUP.txt.
# =============================================================================

mail.enabled=false
mail.smtp.host=smtp.gmail.com
mail.smtp.port=587
mail.smtp.starttls=true

# Sender SMTP / Gmail address
mail.smtp.username=your_email@gmail.com

# SMTP App Password (e.g. 16-character Google App Password, NOT your personal password)
mail.smtp.password=your_app_password_here

# From header displayed to recipient
mail.from=CampusCare <your_email@gmail.com>
